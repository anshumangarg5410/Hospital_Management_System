<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Portal - Hospital Management System</title>
    <link rel="stylesheet" href="../CSS/user_portal.css">
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <h2>MediCare Doctor Portal</h2>
        </div>
        <nav class="nav-menu">
            <div class="nav-item active" onclick="showTab(event,'dashboard')">
                <span class="nav-icon">📊</span> Dashboard
            </div>
            <!-- <div class="nav-item" onclick="showTab(event,'appointments')">
                <span class="nav-icon">📅</span> Appointments
            </div>
            <div class="nav-item" onclick="showTab(event,'patients')">
                <span class="nav-icon">👨‍⚕️</span> My Patients
            </div>
            <div class="nav-item" onclick="showTab(event,'schedule')">
                <span class="nav-icon">⏰</span> Schedule
            </div>
            <div class="nav-item" onclick="showTab(event,'profile')">
                <span class="nav-icon">⚙️</span> Settings
            </div> -->
        </nav>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Topbar -->
        <div class="topbar">
            <div class="topbar-left">
                <h1 id="pageTitle">Dashboard</h1>
                <p>Welcome back, manage your patients and schedule</p>
            </div>
            <div class="user-profile">
                <div class="user-info">
                    <h3 id="displayDoctorName">Dr. Name</h3>
                    <p id="doctorIdText">Doctor ID: DOC-2024-1234</p>
                </div>
                <div class="user-avatar">DN</div>
            </div>
        </div>

        <!-- Content Wrapper -->
        <div class="content-wrapper">

            <!-- Dashboard Tab -->
            <div id="dashboard" class="tab-content active">
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-label">Today's</div>
                        <div class="stat-value" id="statAppointments">5</div>
                        <div class="stat-subtext">Appointments</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Patients</div>
                        <div class="stat-value" id="statPatients">20</div>
                        <div class="stat-subtext">Under Care</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Pending</div>
                        <div class="stat-value" id="statReports">3</div>
                        <div class="stat-subtext">Reports to Review</div>
                    </div>
                </div>


                <div class="section-header">
                    <h2 class="section-title">Today's Appointments</h2>
                    <p class="section-subtitle">Manage your schedule</p>
                </div>
                <div id="dashboardAppointmentsList">
                   
                </div>
            </div>


            <div id="appointments" class="tab-content">
                <div class="section-header">
                    <h2 class="section-title">All Appointments</h2>
                    <p class="section-subtitle">Track all your scheduled consultations</p>
                </div>
                <div id="appointmentsList">

                </div>
            </div>


            <div id="patients" class="tab-content">
                <div class="section-header">
                    <h2 class="section-title">My Patients</h2>
                    <p class="section-subtitle">View and manage patient details</p>
                </div>
                <div id="patientsList">

                </div>
            </div>

            <div id="schedule" class="tab-content">
                <div class="section-header">
                    <h2 class="section-title">Weekly Schedule</h2>
                    <p class="section-subtitle">View and edit your availability</p>
                </div>
                <div id="scheduleList">

                </div>
            </div>

            <div id="profile" class="tab-content">
                <div class="section-header">
                    <h2 class="section-title">Profile Settings</h2>
                    <p class="section-subtitle">Manage your personal information</p>
                </div>
                <form id="doctorProfileForm" onsubmit="event.preventDefault(); updateDoctorProfile();">
                    <div class="form-group">
                        <label class="form-label" for="doctorName">Full Name</label>
                        <input type="text" class="form-control" id="doctorName" placeholder="Enter your full name">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="doctorEmail">Email Address</label>
                        <input type="email" class="form-control" id="doctorEmail" placeholder="Enter your email">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="doctorPhone">Phone Number</label>
                        <input type="tel" class="form-control" id="doctorPhone" placeholder="Enter your phone number">
                    </div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>

                <div class="card" style="margin-top: 24px;">
                    <button onclick="logoutDoctor()" class="btn btn-danger">Logout</button>
                </div>
            </div>

        </div>
    </div>

    <script src="../JS/doctor_portal.js"></script>
</body>
</html>
